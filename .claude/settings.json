{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(_OBS/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/agents-file-inject.mjs"
          },
          {
            "type": "command",
            "command": "node .agents/hooks/sp-version-check.mjs",
            "statusMessage": "Checking Superpowers version...",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/workflow-edit-guard.mjs pre",
            "statusMessage": "Checking workflow-surface edit...",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/workflow-edit-guard.mjs post",
            "statusMessage": "Verifying workflow integrity...",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true,
    "context-mode@context-mode": true,
    "superpowers@x-local-marketplace": true,
    "superpowers@superpowers-marketplace": false
  },
  "extraKnownMarketplaces": {
    "x-local-marketplace": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins"
      }
    },
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": ["www.google-analytics.com"]
    }
  }
}
